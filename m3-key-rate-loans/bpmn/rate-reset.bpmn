<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Rate_Reset_TO_BE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collab_Rate_Reset_TO_BE">
    <bpmn:participant id="Pool_Rate_Reset_TO_BE" name="Банк «Колосок» (учебный): пересчёт ставки" processRef="Rate_Reset_TO_BE" />
  </bpmn:collaboration>
  <bpmn:process id="Rate_Reset_TO_BE" name="Пересчёт плавающей ставки по ключевой ставке ЦБ" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Rate_Reset_TO_BE">
      <bpmn:lane id="Lane_0" name="Система пересчёта">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Кредитный менеджер">
        <bpmn:flowNodeRef>u1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Клиент">
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ce</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Дата фиксации: за 10 дней до периода">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_s"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1M</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="a1" name="Запросить ключевую ставку у ЦБ (SOAP KeyRate)">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="КС изменилась с прошлой фиксации?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e0" name="Ставки без изменений">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="a2" name="Рассчитать ставки: КС + маржа, пол и потолок">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="g2" name="Есть исключения?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="u1" name="Проверить исключения и текст уведомления">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g3" name="">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="a3" name="Отправить уведомления (ДБО, email)">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="p1" name="">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="c1" name="Получить уведомление о новой ставке">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="t1" name="1-е число периода">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_t1"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P10D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="a4" name="Применить ставку, обновить график в АБС">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Новая ставка действует">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ce" name="Клиент знает новую ставку">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" name="" sourceRef="s" targetRef="a1" />
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="a1" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_2" name="нет" sourceRef="g1" targetRef="e0" />
    <bpmn:sequenceFlow id="Flow_3" name="да" sourceRef="g1" targetRef="a2" />
    <bpmn:sequenceFlow id="Flow_4" name="" sourceRef="a2" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_5" name="да" sourceRef="g2" targetRef="u1" />
    <bpmn:sequenceFlow id="Flow_6" name="нет" sourceRef="g2" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="u1" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_8" name="" sourceRef="g3" targetRef="a3" />
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="t1" targetRef="a4" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="a4" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_11" name="" sourceRef="a3" targetRef="p1" />
    <bpmn:sequenceFlow id="Flow_12" name="" sourceRef="p1" targetRef="c1" />
    <bpmn:sequenceFlow id="Flow_13" name="" sourceRef="p1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_14" name="" sourceRef="c1" targetRef="ce" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Rate_Reset_TO_BE"><bpmndi:BPMNPlane id="Plane_Rate_Reset_TO_BE" bpmnElement="Collab_Rate_Reset_TO_BE">
    <bpmndi:BPMNShape id="Pool_Rate_Reset_TO_BE_di" bpmnElement="Pool_Rate_Reset_TO_BE" isHorizontal="true"><dc:Bounds x="120" y="60" width="2060" height="520" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="150" y="60" width="2030" height="240" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="150" y="300" width="2030" height="140" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="150" y="440" width="2030" height="140" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="222.0" y="112.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="190" y="152.0" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="a1_di" bpmnElement="a1"><dc:Bounds x="345.0" y="90.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="535.0" y="105.0" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="448" y="75.0" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="e0_di" bpmnElement="e0"><dc:Bounds x="542.0" y="212.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="510" y="252.0" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="a2_di" bpmnElement="a2"><dc:Bounds x="665.0" y="90.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="855.0" y="105.0" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="768" y="75.0" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="u1_di" bpmnElement="u1"><dc:Bounds x="985.0" y="330.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="g3_di" bpmnElement="g3" isMarkerVisible="true"><dc:Bounds x="1175.0" y="105.0" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1088" y="75.0" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="a3_di" bpmnElement="a3"><dc:Bounds x="1305.0" y="90.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="p1_di" bpmnElement="p1"><dc:Bounds x="1495.0" y="105.0" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1408" y="75.0" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c1_di" bpmnElement="c1"><dc:Bounds x="1465.0" y="470.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="1662.0" y="112.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1630" y="152.0" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="a4_di" bpmnElement="a4"><dc:Bounds x="1785.0" y="90.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="1982.0" y="112.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1950" y="152.0" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="ce_di" bpmnElement="ce"><dc:Bounds x="1662.0" y="492.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1630" y="532.0" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="258" y="130" /><di:waypoint x="345" y="130" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="455" y="130" /><di:waypoint x="535" y="130" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="560" y="155" /><di:waypoint x="560" y="212" /><bpmndi:BPMNLabel><dc:Bounds x="566" y="159" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="585" y="130" /><di:waypoint x="665" y="130" /><bpmndi:BPMNLabel><dc:Bounds x="591" y="110" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="775" y="130" /><di:waypoint x="855" y="130" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="880" y="155" /><di:waypoint x="880" y="370" /><di:waypoint x="985" y="370" /><bpmndi:BPMNLabel><dc:Bounds x="886" y="159" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="905" y="130" /><di:waypoint x="1175" y="130" /><bpmndi:BPMNLabel><dc:Bounds x="911" y="110" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1095" y="370" /><di:waypoint x="1135" y="370" /><di:waypoint x="1135" y="130" /><di:waypoint x="1175" y="130" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1225" y="130" /><di:waypoint x="1305" y="130" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1698" y="130" /><di:waypoint x="1785" y="130" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1895" y="130" /><di:waypoint x="1982" y="130" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1415" y="130" /><di:waypoint x="1495" y="130" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1520" y="155" /><di:waypoint x="1520" y="470" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1545" y="130" /><di:waypoint x="1662" y="130" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1575" y="510" /><di:waypoint x="1662" y="510" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>