<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_KYC_Onboarding_TO_BE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collab_KYC_Onboarding_TO_BE">
    <bpmn:participant id="Pool_KYC_Onboarding_TO_BE" name="Банк «Пример»: открытие расчётного счёта ИП" processRef="KYC_Onboarding_TO_BE" />
  </bpmn:collaboration>
  <bpmn:process id="KYC_Onboarding_TO_BE" name="Онлайн-открытие счёта ИП (TO-BE)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_KYC_Onboarding_TO_BE">
      <bpmn:lane id="Lane_0" name="Клиент">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Система онбординга">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>er</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>te</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Комплаенс-офицер">
        <bpmn:flowNodeRef>tm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ti</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gm2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Представитель банка">
        <bpmn:flowNodeRef>tw</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Клиент ввёл ИНН">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="t1" name="Заполнить анкету из ЕГРИП по ИНН">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t2" name="Проверить данные, снять паспорт камерой">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t3" name="Проверки: перечни, ЗСК, паспорт, ЕГРИП">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="t4" name="Определить уровень проверки (DMN)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="g1" name="Уровень?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="tm" name="Проверить заявку">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="Решение?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="ti" name="Запросить пояснения у клиента">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="eg" name="">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="mi" name="Клиент ответил">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_mi" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tt" name="14 дней без ответа">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_tt"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ea" name="Заявка закрыта">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="tp" name="Проверить пояснения">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g5" name="Достаточно?">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="tr" name="Отказать с причиной, сообщить в РФМ">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="er" name="Отказ">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gm2" name="">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gm" name="">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g3" name="Есть биометрия в ЕБС?">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="te" name="Идентифицировать через ЕБС">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="tw" name="Встретиться, сверить паспорт">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g4" name="">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t5" name="Открыть счёт, сообщить в ФНС">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Счёт открыт">
      <bpmn:incoming>Flow_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" name="" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_4" name="" sourceRef="t4" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_5" name="авто" sourceRef="g1" targetRef="gm" />
    <bpmn:sequenceFlow id="Flow_6" name="ручная" sourceRef="g1" targetRef="tm" />
    <bpmn:sequenceFlow id="Flow_7" name="отказ" sourceRef="g1" targetRef="tr" />
    <bpmn:sequenceFlow id="Flow_8" name="" sourceRef="tr" targetRef="er" />
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="tm" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_10" name="одобрить" sourceRef="g2" targetRef="gm2" />
    <bpmn:sequenceFlow id="Flow_11" name="отказать" sourceRef="g2" targetRef="tr" />
    <bpmn:sequenceFlow id="Flow_12" name="уточнить" sourceRef="g2" targetRef="ti" />
    <bpmn:sequenceFlow id="Flow_13" name="" sourceRef="ti" targetRef="eg" />
    <bpmn:sequenceFlow id="Flow_14" name="" sourceRef="eg" targetRef="mi" />
    <bpmn:sequenceFlow id="Flow_15" name="" sourceRef="eg" targetRef="tt" />
    <bpmn:sequenceFlow id="Flow_16" name="" sourceRef="tt" targetRef="ea" />
    <bpmn:sequenceFlow id="Flow_17" name="" sourceRef="mi" targetRef="tp" />
    <bpmn:sequenceFlow id="Flow_18" name="" sourceRef="tp" targetRef="g5" />
    <bpmn:sequenceFlow id="Flow_19" name="да" sourceRef="g5" targetRef="gm2" />
    <bpmn:sequenceFlow id="Flow_20" name="нет" sourceRef="g5" targetRef="tr" />
    <bpmn:sequenceFlow id="Flow_21" name="" sourceRef="gm2" targetRef="gm" />
    <bpmn:sequenceFlow id="Flow_22" name="" sourceRef="gm" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_23" name="да" sourceRef="g3" targetRef="te" />
    <bpmn:sequenceFlow id="Flow_24" name="нет" sourceRef="g3" targetRef="tw" />
    <bpmn:sequenceFlow id="Flow_25" name="" sourceRef="te" targetRef="g4" />
    <bpmn:sequenceFlow id="Flow_26" name="" sourceRef="tw" targetRef="g4" />
    <bpmn:sequenceFlow id="Flow_27" name="" sourceRef="g4" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_28" name="" sourceRef="t5" targetRef="e" />
  </bpmn:process>
