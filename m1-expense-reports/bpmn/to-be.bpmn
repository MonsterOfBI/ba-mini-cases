<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Expense_TO_BE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collab_Expense_TO_BE">
    <bpmn:participant id="Pool_Expense_TO_BE" name="«Ромашка-Опт»: авансовый отчёт в приложении" processRef="Expense_TO_BE" />
  </bpmn:collaboration>
  <bpmn:process id="Expense_TO_BE" name="Авансовый отчёт (TO-BE)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Expense_TO_BE">
      <bpmn:lane id="Lane_0" name="Сотрудник">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Система">
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Руководитель">
        <bpmn:flowNodeRef>u1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Бухгалтер">
        <bpmn:flowNodeRef>u2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Получил чек">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Сфотографировать чек в приложении">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="a1" name="Распознать QR чека, проверить в ФНС">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="a2" name="Проверить политику лимитов (DMN)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="g1" name="Результат">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t2" name="Объяснить превышение">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="u1" name="Согласовать отчёт (SLA 2 дня)">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="u2" name="Проверить исключения и провести в 1С">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e" name="Возмещено со следующей выплатой">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e0" name="Расход не возмещается">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" name="" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="t1" targetRef="a1" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="a1" targetRef="a2" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="a2" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_4" name="в лимите" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_5" name="превышение" sourceRef="g1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_6" name="запрещено" sourceRef="g1" targetRef="e0" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="t2" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_8" name="" sourceRef="g2" targetRef="u1" />
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="u1" targetRef="u2" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="u2" targetRef="e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Expense_TO_BE"><bpmndi:BPMNPlane id="Plane_Expense_TO_BE" bpmnElement="Collab_Expense_TO_BE">
    <bpmndi:BPMNShape id="Pool_Expense_TO_BE_di" bpmnElement="Pool_Expense_TO_BE" isHorizontal="true"><dc:Bounds x="120" y="60" width="1740" height="660" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="150" y="60" width="1710" height="140" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="150" y="200" width="1710" height="240" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="150" y="440" width="1710" height="140" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_3_di" bpmnElement="Lane_3" isHorizontal="true"><dc:Bounds x="150" y="580" width="1710" height="140" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="222.0" y="112.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="190" y="152.0" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="345.0" y="90.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="a1_di" bpmnElement="a1"><dc:Bounds x="505.0" y="230.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="a2_di" bpmnElement="a2"><dc:Bounds x="665.0" y="230.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="855.0" y="245.0" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="768" y="215.0" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="985.0" y="90.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="u1_di" bpmnElement="u1"><dc:Bounds x="1305.0" y="470.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="1175.0" y="245.0" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1088" y="215.0" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="u2_di" bpmnElement="u2"><dc:Bounds x="1465.0" y="610.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="e_di" bpmnElement="e"><dc:Bounds x="1662.0" y="632.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1630" y="672.0" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="e0_di" bpmnElement="e0"><dc:Bounds x="862.0" y="352.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="830" y="392.0" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="258" y="130" /><di:waypoint x="345" y="130" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="455" y="130" /><di:waypoint x="480" y="130" /><di:waypoint x="480" y="270" /><di:waypoint x="505" y="270" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="615" y="270" /><di:waypoint x="665" y="270" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="775" y="270" /><di:waypoint x="855" y="270" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="905" y="270" /><di:waypoint x="1175" y="270" /><bpmndi:BPMNLabel><dc:Bounds x="911" y="250" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="880" y="245" /><di:waypoint x="880" y="130" /><di:waypoint x="985" y="130" /><bpmndi:BPMNLabel><dc:Bounds x="886" y="223" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="880" y="295" /><di:waypoint x="880" y="352" /><bpmndi:BPMNLabel><dc:Bounds x="886" y="299" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1095" y="130" /><di:waypoint x="1135" y="130" /><di:waypoint x="1135" y="270" /><di:waypoint x="1175" y="270" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1200" y="295" /><di:waypoint x="1200" y="510" /><di:waypoint x="1305" y="510" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1415" y="510" /><di:waypoint x="1440" y="510" /><di:waypoint x="1440" y="650" /><di:waypoint x="1465" y="650" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1575" y="650" /><di:waypoint x="1662" y="650" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>