<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Alert_Triage_TO_BE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collab_Alert_Triage_TO_BE">
    <bpmn:participant id="Pool_Alert_Triage_TO_BE" name="Учебный банк «Пример»: мобильный кошелёк" processRef="Alert_Triage_TO_BE" />
  </bpmn:collaboration>
  <bpmn:process id="Alert_Triage_TO_BE" name="Триаж антифрод-алертов (TO-BE)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Alert_Triage_TO_BE">
      <bpmn:lane id="Lane_0" name="Антифрод-система">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>my</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tbn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ebn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm_log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>em</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Аналитик антифрода">
        <bpmn:flowNodeRef>ta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tab</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eab</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tfp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>efp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Операция поступила">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_s" />
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="t1" name="Применить правила R1–R6, посчитать балл">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="g1" name="Маршрут">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e0" name="Операция проведена">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="tb" name="Приостановить операцию, заблокировать кошелёк">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="eb" name="Заблокировано, клиент уведомлён">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="ts" name="Запросить подтверждение (push / SMS)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="g2" name="">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="my" name="Клиент: «это я»">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_my" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ey" name="Операция проведена">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="mn" name="Клиент: «не я»">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_mn" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="tbn" name="Заблокировать кошелёк">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ebn" name="Заблокировано">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="tm" name="15 мин без ответа">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_tm"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="tm_log" name="Записать в журнал мониторинга">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="em" name="Операция проведена">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="ta" name="Разобрать алерт: история, звонок клиенту">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ga" name="Мошенничество?">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="tab" name="Заблокировать кошелёк, открыть кейс">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="eab" name="Кейс открыт">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="tfp" name="Снять алерт, отметить ложное срабатывание">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="efp" name="Операция проведена">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" name="" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_2" name="нет правил" sourceRef="g1" targetRef="e0" />
    <bpmn:sequenceFlow id="Flow_3" name="R3 или балл ≥ 80" sourceRef="g1" targetRef="tb" />
    <bpmn:sequenceFlow id="Flow_4" name="балл 40–79" sourceRef="g1" targetRef="ts" />
    <bpmn:sequenceFlow id="Flow_5" name="&lt; 40 и &lt; 50 тыс." sourceRef="g1" targetRef="tm_log" />
    <bpmn:sequenceFlow id="Flow_6" name="&lt; 40 и ≥ 50 тыс." sourceRef="g1" targetRef="ta" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="tb" targetRef="eb" />
    <bpmn:sequenceFlow id="Flow_8" name="" sourceRef="ts" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="g2" targetRef="my" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="my" targetRef="ey" />
    <bpmn:sequenceFlow id="Flow_11" name="" sourceRef="g2" targetRef="mn" />
    <bpmn:sequenceFlow id="Flow_12" name="" sourceRef="mn" targetRef="tbn" />
    <bpmn:sequenceFlow id="Flow_13" name="" sourceRef="tbn" targetRef="ebn" />
    <bpmn:sequenceFlow id="Flow_14" name="" sourceRef="g2" targetRef="tm" />
    <bpmn:sequenceFlow id="Flow_15" name="" sourceRef="tm" targetRef="ta" />
    <bpmn:sequenceFlow id="Flow_16" name="" sourceRef="tm_log" targetRef="em" />
    <bpmn:sequenceFlow id="Flow_17" name="" sourceRef="ta" targetRef="ga" />
    <bpmn:sequenceFlow id="Flow_18" name="да" sourceRef="ga" targetRef="tab" />
    <bpmn:sequenceFlow id="Flow_19" name="нет" sourceRef="ga" targetRef="tfp" />
    <bpmn:sequenceFlow id="Flow_20" name="" sourceRef="tab" targetRef="eab" />
    <bpmn:sequenceFlow id="Flow_21" name="" sourceRef="tfp" targetRef="efp" />
  </bpmn:process>
