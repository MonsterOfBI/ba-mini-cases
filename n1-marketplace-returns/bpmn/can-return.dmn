<?xml version="1.0" encoding="UTF-8"?>
<!-- «Можно ли вернуть товар» — учебная модель по Закону о защите прав потребителей (ст. 18, 26.1). Проверить с юристом. -->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="CanReturn" name="Можно ли вернуть" namespace="http://camunda.org/schema/1.0/dmn">
  <decision id="canReturn" name="Можно ли вернуть товар">
    <decisionTable id="t" hitPolicy="FIRST">
      <input id="i1" label="Причина"><inputExpression id="e1" typeRef="string"><text>reason</text></inputExpression></input>
      <input id="i2" label="Товар с индивидуальными свойствами"><inputExpression id="e2" typeRef="boolean"><text>personalized</text></inputExpression></input>
      <input id="i3" label="Дней с получения"><inputExpression id="e3" typeRef="number"><text>daysSinceDelivery</text></inputExpression></input>
      <input id="i4" label="В гарантийном сроке"><inputExpression id="e4" typeRef="boolean"><text>inWarranty</text></inputExpression></input>
      <output id="o1" label="Решение" name="decision" typeRef="string" />
      <output id="o2" label="Маршрут" name="route" typeRef="string" />
      <rule id="r1"><description>Брак в гарантийном сроке</description>
        <inputEntry id="a1"><text>"defect"</text></inputEntry><inputEntry id="b1"><text>-</text></inputEntry><inputEntry id="c1"><text>-</text></inputEntry><inputEntry id="d1"><text>true</text></inputEntry>
        <outputEntry id="x1"><text>"allowed"</text></outputEntry><outputEntry id="y1"><text>"Осмотр в ПВЗ; при сомнении — продавец/экспертиза"</text></outputEntry></rule>
      <rule id="r2"><description>Не тот товар / некомплект — ошибка продавца</description>
        <inputEntry id="a2"><text>"wrong_item","incomplete"</text></inputEntry><inputEntry id="b2"><text>-</text></inputEntry><inputEntry id="c2"><text>-</text></inputEntry><inputEntry id="d2"><text>-</text></inputEntry>
        <outputEntry id="x2"><text>"allowed"</text></outputEntry><outputEntry id="y2"><text>"Без осмотра, деньги сразу"</text></outputEntry></rule>
      <rule id="r3"><description>Надлежащее качество, персонализированный товар</description>
        <inputEntry id="a3"><text>"changed_mind"</text></inputEntry><inputEntry id="b3"><text>true</text></inputEntry><inputEntry id="c3"><text>-</text></inputEntry><inputEntry id="d3"><text>-</text></inputEntry>
        <outputEntry id="x3"><text>"denied"</text></outputEntry><outputEntry id="y3"><text>"Товар с индивидуальными свойствами"</text></outputEntry></rule>
      <rule id="r4"><description>Передумал в течение 7 дней (дистанционная продажа)</description>
        <inputEntry id="a4"><text>"changed_mind"</text></inputEntry><inputEntry id="b4"><text>false</text></inputEntry><inputEntry id="c4"><text>&lt;= 7</text></inputEntry><inputEntry id="d4"><text>-</text></inputEntry>
        <outputEntry id="x4"><text>"allowed"</text></outputEntry><outputEntry id="y4"><text>"Осмотр товарного вида в ПВЗ"</text></outputEntry></rule>
      <rule id="r5"><description>Иначе — отказ с объяснением</description>
        <inputEntry id="a5"><text>-</text></inputEntry><inputEntry id="b5"><text>-</text></inputEntry><inputEntry id="c5"><text>-</text></inputEntry><inputEntry id="d5"><text>-</text></inputEntry>
        <outputEntry id="x5"><text>"denied"</text></outputEntry><outputEntry id="y5"><text>"Срок возврата истёк или причина не подходит"</text></outputEntry></rule>
    </decisionTable>
  </decision>
</definitions>
