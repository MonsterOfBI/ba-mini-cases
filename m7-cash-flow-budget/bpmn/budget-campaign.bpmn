<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Budget_Campaign" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collab_Budget_Campaign">
    <bpmn:participant id="Pool_Budget_Campaign" name="ООО «Ромашка-Опт»: годовой бюджет движения денежных средств" processRef="Budget_Campaign" />
  </bpmn:collaboration>
  <bpmn:process id="Budget_Campaign" name="Бюджетная кампания БДДС" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Budget_Campaign">
      <bpmn:lane id="Lane_0" name="Финансовый директор">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>td</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Финансово-экономический отдел">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Руководители ЦФО">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Генеральный директор">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="1 сентября: старт кампании">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_s"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">R/2026-09-01/P1Y</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Утвердить сценарные условия: рост продаж, цены, ставки">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t2" name="Разослать шаблоны и сроки">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t3" name="Подготовить заявки по своим статьям">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t4" name="Свести БДДС, построить платёжный календарь">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g" name="Остаток ниже резерва?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="td" name="Решить: перенос платежей, кредит, сокращение заявок">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t6" name="Скорректировать заявки">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t5" name="Утвердить бюджет">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t7" name="Зафиксировать версию «Бюджет v1», загрузить в модель">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Бюджет утверждён">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" name="" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_4" name="" sourceRef="t4" targetRef="g" />
    <bpmn:sequenceFlow id="Flow_5" name="да" sourceRef="g" targetRef="td" />
    <bpmn:sequenceFlow id="Flow_6" name="" sourceRef="td" targetRef="t6" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="t6" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_8" name="нет" sourceRef="g" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="t5" targetRef="t7" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="t7" targetRef="e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Budget_Campaign"><bpmndi:BPMNPlane id="Plane_Budget_Campaign" bpmnElement="Collab_Budget_Campaign">
    <bpmndi:BPMNShape id="Pool_Budget_Campaign_di" bpmnElement="Pool_Budget_Campaign" isHorizontal="true"><dc:Bounds x="120" y="60" width="1740" height="560" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="150" y="60" width="1710" height="140" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="150" y="200" width="1710" height="140" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="150" y="340" width="1710" height="140" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_3_di" bpmnElement="Lane_3" isHorizontal="true"><dc:Bounds x="150" y="480" width="1710" height="140" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="222.0" y="112.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="190" y="152.0" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="345.0" y="90.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="505.0" y="230.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="665.0" y="370.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="825.0" y="230.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="g_di" bpmnElement="g" isMarkerVisible="true"><dc:Bounds x="1015.0" y="245.0" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="928" y="215.0" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="td_di" bpmnElement="td"><dc:Bounds x="985.0" y="90.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t6_di" bpmnElement="t6"><dc:Bounds x="1145.0" y="370.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t5_di" bpmnElement="t5"><dc:Bounds x="1305.0" y="510.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t7_di" bpmnElement="t7"><dc:Bounds x="1465.0" y="230.0" width="110" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="e_di" bpmnElement="e"><dc:Bounds x="1662.0" y="252.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1630" y="292.0" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="258" y="130" /><di:waypoint x="345" y="130" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="455" y="130" /><di:waypoint x="480" y="130" /><di:waypoint x="480" y="270" /><di:waypoint x="505" y="270" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="615" y="270" /><di:waypoint x="640" y="270" /><di:waypoint x="640" y="410" /><di:waypoint x="665" y="410" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="775" y="410" /><di:waypoint x="800" y="410" /><di:waypoint x="800" y="270" /><di:waypoint x="825" y="270" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="935" y="270" /><di:waypoint x="1015" y="270" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="1040" y="245" /><di:waypoint x="1040" y="170" /><bpmndi:BPMNLabel><dc:Bounds x="1046" y="223" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1095" y="130" /><di:waypoint x="1120" y="130" /><di:waypoint x="1120" y="410" /><di:waypoint x="1145" y="410" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1200" y="450" /><di:waypoint x="1200" y="475" /><di:waypoint x="880" y="475" /><di:waypoint x="880" y="310" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1040" y="295" /><di:waypoint x="1040" y="550" /><di:waypoint x="1305" y="550" /><bpmndi:BPMNLabel><dc:Bounds x="1048" y="530" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1415" y="550" /><di:waypoint x="1440" y="550" /><di:waypoint x="1440" y="270" /><di:waypoint x="1465" y="270" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1575" y="270" /><di:waypoint x="1662" y="270" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>