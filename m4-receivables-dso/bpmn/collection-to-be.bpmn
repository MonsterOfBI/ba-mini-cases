<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Collection_TO_BE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collab_Collection_TO_BE">
    <bpmn:participant id="Pool_Collection_TO_BE" name="ООО «Ромашка-Опт»: взыскание долга по реализации" processRef="Collection_TO_BE" />
  </bpmn:collaboration>
  <bpmn:process id="Collection_TO_BE" name="Работа с просроченной дебиторкой (TO-BE)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Collection_TO_BE">
      <bpmn:lane id="Lane_0" name="Система (1С + CRM)">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Кредит-контролёр">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Менеджер по продажам">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Юрист">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Прошёл день после срока оплаты">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_s"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="t1" name="Отправить напоминание (email + SMS)">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="g1" name="">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m1" name="Долг оплачен">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_m1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e1" name="Долг погашен">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="tm1" name="+7 дней">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_tm1"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="t2" name="Позвонить, записать обещанную дату оплаты">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="g2" name="">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m2" name="Долг оплачен">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_m2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e2" name="Долг погашен">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="tm2" name="+14 дней">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_tm2"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="t3" name="Стоп отгрузок, звонок руководителю клиента">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="g4" name="">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m4" name="Долг оплачен">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_m4" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e5" name="Долг погашен">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="tm4" name="+9 дней">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_tm4"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P9D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="t4" name="Направить претензию">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="g3" name="">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m3" name="Долг оплачен">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_m3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e3" name="Долг погашен">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="tm3" name="30 дней на ответ">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_tm3"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="t5" name="Иск в арбитраж или списание">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e4" name="Передано в суд / списано">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" name="" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="g1" targetRef="m1" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="m1" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_4" name="" sourceRef="g1" targetRef="tm1" />
    <bpmn:sequenceFlow id="Flow_5" name="" sourceRef="tm1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_6" name="" sourceRef="t2" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="g2" targetRef="m2" />
    <bpmn:sequenceFlow id="Flow_8" name="" sourceRef="m2" targetRef="e2" />
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="g2" targetRef="tm2" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="tm2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_11" name="" sourceRef="t4" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_12" name="" sourceRef="g3" targetRef="m3" />
    <bpmn:sequenceFlow id="Flow_13" name="" sourceRef="m3" targetRef="e3" />
    <bpmn:sequenceFlow id="Flow_14" name="" sourceRef="g3" targetRef="tm3" />
    <bpmn:sequenceFlow id="Flow_15" name="" sourceRef="tm3" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_16" name="" sourceRef="t5" targetRef="e4" />
    <bpmn:sequenceFlow id="Flow_17" name="" sourceRef="t3" targetRef="g4" />
    <bpmn:sequenceFlow id="Flow_18" name="" sourceRef="g4" targetRef="m4" />
    <bpmn:sequenceFlow id="Flow_19" name="" sourceRef="m4" targetRef="e5" />
    <bpmn:sequenceFlow id="Flow_20" name="" sourceRef="g4" targetRef="tm4" />
    <bpmn:sequenceFlow id="Flow_21" name="" sourceRef="tm4" targetRef="t4" />
  </bpmn:process>
